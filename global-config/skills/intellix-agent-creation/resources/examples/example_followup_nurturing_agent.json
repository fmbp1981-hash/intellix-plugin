    { "config_id": "cfg_messaging_provider", "field_path": "interfaces.whatsapp", "description": "Credenciais do provedor de mensageria", "type": "json", "required": true, "default_value": null, "validation_rule": "api_url, api_key, instance_name", "sensitive": true, "example_value": "{\"api_url\": \"https://evolution.example.com\", \"api_key\": \"xxx\", \"instance_name\": \"main\"}" },
