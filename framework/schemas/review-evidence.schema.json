{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "task_digest",
    "phase_base",
    "reviewed_revision",
    "branch",
    "diff_ref",
    "executor_identity",
    "reviewer_assignment",
    "reviewer_identity",
    "access",
    "decision",
    "reviewed_files",
    "fileset_digest",
    "project_digest",
    "source_digest",
    "kernel_digest",
    "reviewed_at",
    "evidence",
    "limitations"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "task": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "task_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "phase_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "diff_ref": {"type": "string", "minLength": 81},
    "executor_identity": {"type": "string", "minLength": 1},
    "reviewer_assignment": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1},
    "access": {"type": "string", "enum": ["read-only"]},
    "decision": {"type": "string", "enum": ["approved", "changes_requested"]},
    "reviewed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "fileset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kernel_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
