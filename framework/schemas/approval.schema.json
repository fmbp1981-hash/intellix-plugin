{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["task", "gate", "decision", "actor", "timestamp", "evidence"],
  "properties": {
    "task": {"type": "string"},
    "gate": {"type": "string"},
    "decision": {"type": "string", "enum": ["approved", "rejected"]},
    "actor": {"type": "string"},
    "timestamp": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "phase_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string", "minLength": 1},
    "pre_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "post_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "project_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kernel_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "control_plane_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_ref": {"type": "string", "minLength": 1},
    "review_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "reference", "decided_at", "limitations"],
      "properties": {
        "origin": {"type": "string", "enum": ["controlling-session"]},
        "reference": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "minLength": 1},
        "limitations": {"type": "string", "minLength": 1}
      }
    },
    "review_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "revision", "required_checks", "decision", "queried_at"],
      "properties": {
        "provider": {"type": "string", "enum": ["github"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision": {"type": "string", "enum": ["eligible"]},
        "queried_at": {"type": "string", "minLength": 1}
      }
    },
    "completion_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "provider", "source", "repository", "revision", "required_checks", "observed_checks", "decision", "reasons", "queried_at"],
      "properties": {
        "schema_version": {"type": "string", "enum": ["1.0.0"]},
        "provider": {"type": "string", "enum": ["github"]},
        "source": {"type": "string", "enum": ["github-api"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_checks": {"type": "array"},
        "decision": {"type": "string", "enum": ["eligible"]},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "queried_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
