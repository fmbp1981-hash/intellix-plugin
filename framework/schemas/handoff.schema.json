{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "task_digest", "commit", "diff_ref", "from", "to", "from_identity", "to_identity", "access", "status", "summary", "changed_files", "evidence", "open_risks", "next_action", "checkpoint_ref"],
  "properties": {
    "task": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "task_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "diff_ref": {"type": "string", "minLength": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "from_identity": {"type": "string", "minLength": 1},
    "to_identity": {"type": "string", "minLength": 1},
    "access": {"type": "string", "enum": ["read-only"]},
    "status": {"type": "string", "enum": ["ready", "blocked", "changes_requested", "approved"]},
    "summary": {"type": "string", "minLength": 15},
    "changed_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "open_risks": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 1},
    "checkpoint_ref": {"type": "string", "minLength": 1}
  }
}
