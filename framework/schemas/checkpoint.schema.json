{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "task", "state", "context", "last_command", "last_result", "stop_point", "open_risks", "active_plan", "next_actions", "branch", "worktree", "commit", "recovery_command", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "task": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "state": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "last_command": {"type": "string", "minLength": 1},
    "last_result": {"type": "string", "minLength": 1},
    "stop_point": {"type": "string", "minLength": 1},
    "open_risks": {"type": "array", "items": {"type": "string"}},
    "active_plan": {"type": "string", "minLength": 1},
    "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "branch": {"type": "string", "minLength": 1},
    "worktree": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "recovery_command": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1}
  }
}
