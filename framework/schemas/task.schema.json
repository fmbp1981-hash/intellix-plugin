{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "status", "objective", "source", "risk", "ownership", "scope", "acceptance_criteria", "verification", "gates", "handoff"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^TASK-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 5},
    "status": {"type": "string", "enum": ["DRAFT", "READY_FOR_ARCH_REVIEW", "READY", "IN_PROGRESS", "BLOCKED", "IN_REVIEW", "CHANGES_REQUESTED", "APPROVED", "MERGED", "VERIFIED", "RELEASED"]},
    "objective": {"type": "string", "minLength": 15},
    "source": {
      "type": "object", "required": ["prd", "architecture", "spec"], "additionalProperties": false,
      "properties": {"prd": {"type": "string"}, "architecture": {"type": "string"}, "spec": {"type": "string"}, "adrs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "risk": {
      "type": "object", "required": ["level", "reasons", "irreversible_actions"], "additionalProperties": false,
      "properties": {"level": {"type": "string", "enum": ["low", "medium", "high", "critical"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "irreversible_actions": {"type": "array", "items": {"type": "string"}}}
    },
    "ownership": {
      "type": "object", "required": ["architect", "executor", "reviewer"], "additionalProperties": false,
      "properties": {"architect": {"type": "string"}, "executor": {"type": "string"}, "reviewer": {"type": "string"}, "domain_role": {"type": "string"}}
    },
    "scope": {
      "type": "object", "required": ["create", "modify", "forbidden"], "additionalProperties": false,
      "properties": {"create": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "modify": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "forbidden": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "given", "when", "then"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "given": {"type": "string"}, "when": {"type": "string"}, "then": {"type": "string"}}}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["command", "proves"], "additionalProperties": false, "properties": {"command": {"type": "string"}, "proves": {"type": "string"}}}},
    "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rollback": {"type": ["string", "null"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "handoff": {"type": "object", "required": ["required_evidence", "open_questions"], "additionalProperties": false, "properties": {"required_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "open_questions": {"type": "array", "items": {"type": "string"}}}}
  }
}
