# .env.example — Skill: live-chat-support (Omnichannel)
# Copie para .env.local e preencha com suas credenciais reais
# NUNCA commite o arquivo .env.local

# ============================================
# OBRIGATÓRIO — SUPABASE
# Dashboard → Settings → API
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# OBRIGATÓRIO — LLM PROVIDER (OpenAI ou Anthropic)
# ============================================
LLM_PROVIDER=openai
# Opções: 'openai' ou 'anthropic'

LLM_API_KEY=
# OpenAI: platform.openai.com → API Keys
# Anthropic: console.anthropic.com → API Keys

LLM_MODEL=gpt-4o
# OpenAI: gpt-4o, gpt-4o-mini
# Anthropic: claude-sonnet-4-20250514, claude-haiku-4-5-20251001

# ============================================
# OBRIGATÓRIO — CONFIGURAÇÕES DO SISTEMA
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL pública do painel (para links nas notificações)

HUMAN_INACTIVITY_TIMEOUT_MINUTES=10
# Tempo antes de devolver atendimento à IA (padrão: 10, faixa: 5-30)

HANDOFF_RENOTIFY_MINUTES=5
# Intervalo para reenviar notificação se ninguém assumir (padrão: 5)

HANDOFF_EXPIRE_MINUTES=15
# Tempo para IA retomar se ninguém assumir (padrão: 15)

# ============================================
# CONFIGURAÇÕES DO AGENTE DE IA
# ============================================
AI_SYSTEM_PROMPT="Você é um assistente de atendimento da [EMPRESA]. Seja cordial, objetivo e helpful."
AI_MAX_CONTEXT_MESSAGES=50

# ============================================
# CANAIS DE MENSAGERIA — CONFIGURE APENAS OS QUE USAR
# O sistema funciona com qualquer combinação de canais.
# Webchat funciona sem nenhuma credencial externa.
# ============================================

# --- WHATSAPP: API OFICIAL (Meta Cloud API) [RECOMENDADO] ---
# Meta Business Suite → WhatsApp → API Setup
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# O Verify Token é um string que você define e configura no Meta dashboard

# --- WHATSAPP: EVOLUTION API ---
# Painel da instância → Settings
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# --- WHATSAPP: Z-API ---
# Painel Z-API → Instâncias → Token
ZAPI_URL=
ZAPI_TOKEN=
ZAPI_INSTANCE_ID=

# --- WHATSAPP: OUTRO PROVIDER ---
# Se usar WPPConnect, Baileys, ou outro:
# Configure via tabela `channels` no banco com type='whatsapp' e provider='custom'
# e crie um adapter customizado (veja omnichannel-spec.md)

# --- INSTAGRAM DM ---
# Meta Business Suite → Instagram → Messenger API → Gerar Token
# Docs: https://developers.facebook.com/docs/instagram-messaging
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_VERIFY_TOKEN=

# --- TELEGRAM ---
# Abra @BotFather no Telegram → /newbot → copie o token
# Docs: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# O Webhook Secret é opcional mas recomendado (string aleatória)
