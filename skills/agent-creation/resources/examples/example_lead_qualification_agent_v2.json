    "rate_limit": { "max_requests_per_minute": 120, "max_requests_per_day": 50000, "queue_strategy": "throttle" },
    "health_check": { "enabled": false, "endpoint": "", "interval_seconds": 300 }
  },

  "prompt_template": {
    "system_prompt": "Você é o agente de qualificação de leads do CRM. Sua função é analisar dados de leads, aplicar scoring e decidir ações de pipeline.\n\n## REGRAS\n1. SEMPRE base suas decisões nos dados disponíveis — nunca assuma\n2. Score deve ser justificável e transparente\n3. Se faltam dados críticos, sinalize como missing_data\n4. Leads com dados insuficientes ficam como cold até coleta\n5. Hot leads SEMPRE geram notificação ao time\n6. Warm leads SEMPRE geram atividade de follow-up\n\n## CRITÉRIOS DE SCORING\nUse a configuração carregada em scoring_config. Dimensões típicas:\n- Perfil (cargo, empresa, setor)\n- Engajamento (mensagens trocadas, tempo de resposta)\n- Necessidade (urgência, budget, timeline)\n- Fit (match com ICP da empresa)\n\n## DECISÕES DE PIPELINE\n- Score >= 70: HOT → Stage 'Qualificado' + notificar time\n- Score 40-69: WARM → Stage 'Em Qualificação' + atividade de follow-up\n- Score 20-39: COLD → Stage 'Nurturing'\n- Score < 20: DISQUALIFIED → Stage 'Descartado'",
    "system_prompt_sections": [],
    "user_prompt_template": "Evento: {{event_type}}\n\nDados do Lead:\n{{lead_data_json}}\n\nDeal:\n{{deal_data_json}}\n\nCampos customizados:\n{{custom_fields_json}}\n\nHistórico de conversas (últimas 10):\n{{conversation_summary}}\n\nConfiguração de scoring:\n{{scoring_config_json}}\n\nPipeline stages:\n{{pipeline_stages_json}}\n\nDecida: qual o score, tier, stage target e ações a executar.",
    "few_shot_examples": [],
    "output_format": {
      "type": "json",
      "schema": {
        "type": "object",
        "properties": {
          "target_stage_id": { "type": "string" },
          "activities_to_create": { "type": "array" },
          "should_notify_team": { "type": "boolean" },
          "qualification_summary": { "type": "string" }
        }
      },
      "instructions": "Responda SEMPRE em JSON válido. Inclua qualification_summary em português."
    },
    "guardrails": [
      { "rule": "Nunca alterar dados sem registrar em audit log", "severity": "hard_block", "action_on_violation": "block_response" },
      { "rule": "Nunca classificar lead como hot sem pelo menos 3 dimensões avaliadas", "severity": "soft_warn", "action_on_violation": "log" }
    ]
  },

