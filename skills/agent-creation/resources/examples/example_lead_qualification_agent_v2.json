  "actions": [
    {
      "action_id": "action_score_and_move",
      "action_name": "Qualificar e mover no pipeline",
      "action_type": "tool_call",
      "description": "Calcula score do lead e move o deal para o stage correspondente",
      "tool_ref": "tool_score_lead",
      "parameters": {},
      "conditions": [
        { "field": "deal.id", "operator": "exists", "value": true }
      ],
      "side_effects": ["updates_deal_stage", "creates_qualification_log"],
      "requires_confirmation": false
    },
    {
      "action_id": "action_create_followup",
      "action_name": "Criar tarefa de follow-up",
      "action_type": "schedule_task",
      "description": "Cria uma atividade de follow-up atribuída ao vendedor responsável",
      "tool_ref": "tool_create_activity",
      "parameters": {},
      "conditions": [
        { "field": "score_result.tier", "operator": "in", "value": ["hot", "warm"] }
